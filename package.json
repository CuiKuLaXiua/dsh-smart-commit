{
  "name": "dsh-smart-commit",
  "version": "0.4.1",
  "description": "智能 Git 提交：分析变更并生成符合 Conventional Commits 的中文提交，支持 WIP/amend/squash",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "author": "dsh-smart-commit contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CuiKuLaXiua/dsh-smart-commit.git"
  },
  "homepage": "https://github.com/CuiKuLaXiua/dsh-smart-commit#readme",
  "bugs": {
    "url": "https://github.com/CuiKuLaXiua/dsh-smart-commit/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "scripts": {
    "smoke": "node smoke.mjs"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "icon.svg"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "git",
    "commit",
    "conventional-commits"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0-rc.6 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    }
  }
}
